# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# .env is gitignored. NEVER commit it, paste it into chat, or share it in a
# screenshot. If a key is exposed, revoke it in the provider dashboard and
# issue a new one — that costs nothing and takes a minute.
#
# These keys are used ONLY by build-time scripts (scripts/generate-audio.mjs).
# They are never bundled into the app and never reach a user's phone. That is
# deliberate: the app plays pre-rendered mp3 files and makes no API calls.
#
# Do NOT prefix these with VITE_ — that would ship them to the browser.

# Sarvam TTS — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional overrides
# bulbul:v3 female speakers: ritu, priya, neha, pooja, simran, kavya, ishita,
#                            shreya, roopa, tanya, shruti, suhani, kavitha, rupali
SARVAM_SPEAKER=ritu
# Assamese (as-IN) requires bulbul:v3 or v4. v2 does not support it.
SARVAM_MODEL=bulbul:v3

# Bhashini (government platform) — https://bhashini.gov.in
# Free alternative for Assamese if Sarvam beta access is not granted.
BHASHINI_API_KEY=
